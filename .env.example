# Protect the private dashboard with a browser username/password prompt.
APP_PASSWORD=change-this-to-a-long-random-password

# Email is sent through Resend. Verify the sender address/domain in Resend first.
RESEND_API_KEY=
FROM_EMAIL=

# Maximum courts added for a single matching date/time slot (1 or 2).
MAX_AUTO_BOOKINGS=2
